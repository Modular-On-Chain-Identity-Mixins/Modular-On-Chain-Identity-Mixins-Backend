# ---------------------------------------------------------------------------
# Soroban deployment configuration — copy this file to `.env` and fill in.
# The real `.env` file is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# RPC endpoint for the target network.
# Testnet: https://soroban-testnet.stellar.org
# Mainnet: https://rpc.mainnet.stellar.org  (or your RPC provider's URL)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase for the selected network.
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Secret key (or identity name) of the deploying/admin account.
# Testnet friendbot: `stellar keys fund <NAME>` — see README.
SOROBAN_SECRET_KEY=

# --- Contract IDs (filled in by scripts/deploy.sh) --------------------------
IDENTITY_REGISTRY_ID=
POOL_ID=

# --- Admin addresses (G... public keys) --------------------------------------
IDENTITY_REGISTRY_ADMIN=
POOL_ADMIN=

# Asset contract to wrap in the pool.
# Deploy one with: stellar contract asset deploy --asset <CODE:ISSUER>
TOKEN_ID=

# --- Pool compliance defaults (tune to your risk policy) --------------------
REQUIRED_TIER=1
DAILY_VOLUME_LIMIT=1000000000
MONTHLY_VOLUME_LIMIT=10000000000
# JSON array of restricted ISO 3166-1 alpha-2 country codes, e.g. '["IR","KP"]'
RESTRICTED_JURISDICTIONS=[]
