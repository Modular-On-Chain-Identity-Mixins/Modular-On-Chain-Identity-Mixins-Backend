# Stellar network configuration
# For public testnet: https://rpc-futurenet.stellar.org
# For local/sandbox: use the default Soroban CLI local network
SOROBAN_RPC_URL=https://rpc-futurenet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Future Network ; October 2022

# Deployer account keys (secret seed)
# Generate with: soroban keys generate deployer
SOROBAN_SECRET_KEY=

# Contract parameters
IDENTITY_REGISTRY_ADMIN=
REQUIRED_TIER=1
DAILY_VOLUME_LIMIT=1000000000
MONTHLY_VOLUME_LIMIT=10000000000

# After deploying identity-registry, set its ID here for pool deployment
IDENTITY_REGISTRY_ID=
